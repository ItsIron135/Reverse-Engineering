-- Your Happy Place port installer. Run in Studio's Command Bar in Edit mode.
-- Generated by tools/build_installer.py from src/. Rerunning replaces the previous install.
assert(not game:GetService("RunService"):IsRunning(), "Stop Play before installing")

local ChangeHistoryService = game:GetService("ChangeHistoryService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Lighting = game:GetService("Lighting")
local StarterPlayer = game:GetService("StarterPlayer")
local starterScripts = StarterPlayer:WaitForChild("StarterPlayerScripts")

local IMAGES = {
	VignetteImage = "rbxassetid://82354150218129", -- assets/vignette.png (UE vignette, intensity 0.32)
	LensDirtImage = "rbxassetid://70783488855847", -- /Game/Textures/lensDirt11 (bloom dirt mask)
	CloudImage = "rbxassetid://91504577422474", -- /Game/Textures/Cloud (Map6 cloud material input)
	LensDirtOverlayImage = "rbxassetid://83251249094103", -- lensDirt11 converted by tools/make_lens_dirt_overlay.py
}

local MODULES = {
--@MODULES@
}

local PLAYER = --@PLAYER@

local recording = ChangeHistoryService:TryBeginRecording("Install Your Happy Place port")

-- Back up the place's own lighting once, before anything from this project touches it.
local LIGHTING_PROPS = { "Ambient", "OutdoorAmbient", "Brightness", "ColorShift_Top", "ColorShift_Bottom", "ExposureCompensation", "EnvironmentDiffuseScale", "EnvironmentSpecularScale", "ClockTime" }
local backup = ServerStorage:FindFirstChild("YHP_RestoreBackup")
if not backup then
	backup = Instance.new("Folder")
	backup.Name = "YHP_RestoreBackup"
	for _, prop in LIGHTING_PROPS do
		backup:SetAttribute(prop, Lighting[prop])
	end
	backup:SetAttribute("CameraMode", StarterPlayer.CameraMode.Name)
	backup:SetAttribute("EnableMouseLockOption", StarterPlayer.EnableMouseLockOption)
	local originals = Instance.new("Folder")
	originals.Name = "OriginalLightingEffects"
	originals.Parent = backup
	for _, child in Lighting:GetChildren() do
		if child:IsA("PostEffect") or child:IsA("Atmosphere") then
			child.Parent = originals
		end
	end
	backup.Parent = ServerStorage
end
-- Older backups (from the v2 camera) lack some keys; their current values are still the originals.
for _, prop in LIGHTING_PROPS do
	if backup:GetAttribute(prop) == nil then
		backup:SetAttribute(prop, Lighting[prop])
	end
end
if backup:GetAttribute("EnableMouseLockOption") == nil then
	backup:SetAttribute("EnableMouseLockOption", StarterPlayer.EnableMouseLockOption)
end

-- Remove earlier installs (including the superseded v2 camera).
for _, name in { "YHPRealisticCamera", "YHPFilmLook", "YHPPlayer" } do
	local old = starterScripts:FindFirstChild(name)
	if old then
		old:Destroy()
	end
end
for _, name in { "YHPCameraSettings", "YHPCameraDynamics", "YHP" } do
	local old = ReplicatedStorage:FindFirstChild(name)
	if old then
		old:Destroy()
	end
end
for _, child in Lighting:GetChildren() do
	if child:GetAttribute("YHPManaged") then
		child:Destroy()
	end
end

local folder = Instance.new("Folder")
folder.Name = "YHP"
for name, value in {
	Enabled = true,
	Suspended = false, -- set true while another system (cutscene) owns the camera
	SourceMovement = true, -- source walk/run speeds and acceleration; false keeps Roblox WalkSpeed
	MouseSensitivityScale = 1,
	ShakeScale = 1,
	VignetteEnabled = true,
	LensDirtEnabled = true,
	LensDirtBase = 0.12, -- smudge opacity with no bright light in view
	LensDirtMax = 0.7, -- opacity when facing the sun or a light
	MotionBlurEnabled = true,
	MotionBlurAmount = 1, -- source MotionBlurAmount
	ConstantBlurScale = 2, -- multiplier on the source depth-of-field blur
	SharpenRimEnabled = true, -- bright rim from the game's Sharpen2 filter
	SharpenRimStrength = 0.85,
	SharpenRimColor = Color3.fromRGB(220, 232, 255),
} do
	folder:SetAttribute(name, value)
end
for name, id in IMAGES do
	folder:SetAttribute(name, id)
end
for _, entry in MODULES do
	local module = Instance.new("ModuleScript")
	module.Name = entry[1]
	module.Source = entry[2]
	module.Parent = folder
end
local textures = Instance.new("Folder")
textures.Name = "SourceTextures"
for name, id in IMAGES do
	local decal = Instance.new("Decal")
	decal.Name = name:gsub("Image$", "")
	decal.Texture = id
	decal.Parent = textures
end
textures.Parent = folder
folder.Parent = ReplicatedStorage

local player = Instance.new("LocalScript")
player.Name = "YHPPlayer"
player.Source = PLAYER
player.Parent = starterScripts

StarterPlayer.CameraMode = Enum.CameraMode.Classic
StarterPlayer.EnableMouseLockOption = false -- LeftShift is the source's run key

-- Lighting approximation of the source PostProcessVolume and Map6 sun (see docs/lighting.md).
local function kelvinToColor(kelvin)
	local t = kelvin / 100
	local r = t <= 66 and 255 or 329.698727446 * (t - 60) ^ -0.1332047592
	local g = t <= 66 and 99.4708025861 * math.log(t) - 161.1195681661 or 288.1221695283 * (t - 60) ^ -0.0755148492
	local b = t >= 66 and 255 or (t <= 19 and 0 or 138.5177312231 * math.log(t - 10) - 305.0447927307)
	return Color3.fromRGB(math.clamp(r, 0, 255), math.clamp(g, 0, 255), math.clamp(b, 0, 255))
end
Lighting.ColorShift_Top = kelvinToColor(4687.2)

-- Values derived by tools/fit_color_grade.py and docs/source-values.md.
-- Exposure: the game clamps auto exposure at EV100 0 with bias -8.84, a fixed exposure that needs
-- about 100 cd/m2 for middle grey. Map6's 20 lux sun leaves lit surfaces ~5.7 stops under a normal
-- auto exposure; Roblox's lowest setting is -3.
Lighting.ExposureCompensation = -3
local grade = Instance.new("ColorCorrectionEffect")
grade.Name = "YHP_ColorGrade"
grade.Contrast = -0.088 -- fit of ColorContrast 1.2 + shadow/midtone gamma 1.48 + FilmWhiteClip 1
grade.Brightness = 0.113
grade.Saturation = 0 -- ColorSaturation is not overridden
grade.TintColor = Color3.new(1, 1, 1) -- WhiteTemp 6500 K is the neutral point
local bloom = Instance.new("BloomEffect")
bloom.Name = "YHP_Bloom"
bloom.Threshold = 0 -- BloomThreshold keeps the engine default -1: no threshold
bloom.Size = 56 -- widest Roblox radius; the source's widest kernel spans most of the screen
bloom.Intensity = 1 -- source 250 is not in comparable units
-- Level 0 sky: the game's mud_road_puresky_2kColorGrad cube map, faces converted by
-- tools/extract_cubemap_faces.py (side faces mirrored for Roblox's skybox convention).
local oldSky = Lighting:FindFirstChildOfClass("Sky")
if oldSky then
	oldSky.Parent = backup:FindFirstChild("OriginalLightingEffects") or backup
end
local sky = Instance.new("Sky")
sky.Name = "YHP_Level0Sky"
sky.SkyboxFt = "rbxassetid://100264281804965"
sky.SkyboxRt = "rbxassetid://85329701483424"
sky.SkyboxBk = "rbxassetid://84410854009063"
sky.SkyboxLf = "rbxassetid://121166612591163"
sky.SkyboxUp = "rbxassetid://134574778259308"
sky.SkyboxDn = "rbxassetid://102060416831931"
sky.CelestialBodiesShown = false
sky.StarCount = 0

for _, effect in { grade, bloom, sky } do
	effect:SetAttribute("YHPManaged", true)
	effect.Parent = Lighting
end

if recording then
	ChangeHistoryService:FinishRecording(recording, Enum.FinishRecordingOperation.Commit)
end
return "Installed ReplicatedStorage.YHP, StarterPlayerScripts.YHPPlayer and Lighting effects. Save the place to keep them."
