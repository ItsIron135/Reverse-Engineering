local function makeNoise(perm, angles)
	local p, gx, gy = table.create(512), table.create(256), table.create(256)
	for i = 0, 511 do
		p[i] = perm[i % 256 + 1]
	end
	for i = 0, 255 do
		gx[i], gy[i] = math.cos(angles[i + 1]), math.sin(angles[i + 1])
	end
	local function dot(ix, iy, dx, dy)
		local g = p[p[ix] + iy]
		return gx[g] * dx + gy[g] * dy
	end
	return function(x, y)
		local x0, y0 = math.floor(x), math.floor(y)
		local xf, yf = x - x0, y - y0
		local xi, yi = bit32.band(x0, 255), bit32.band(y0, 255)
		local u = xf * xf * xf * (xf * (xf * 6 - 15) + 10)
		local v = yf * yf * yf * (yf * (yf * 6 - 15) + 10)
		local n00 = dot(xi, yi, xf, yf)
		local n10 = dot(xi + 1, yi, xf - 1, yf)
		local n01 = dot(xi, yi + 1, xf, yf - 1)
		local n11 = dot(xi + 1, yi + 1, xf - 1, yf - 1)
		local a = n00 + (n10 - n00) * u
		local b = n01 + (n11 - n01) * u
		return (a + (b - a) * v) * 1.41
	end
end

local noiseA, noiseB = makeNoise(P17, A17), makeNoise(P22, A22)

return function(x: number, z: number): number
	return 95 * noiseA(x / 650, z / 650) + 22 * noiseB(x / 320 + 40.5, z / 320 + 40.5)
end
